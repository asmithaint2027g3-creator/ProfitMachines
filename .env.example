# ─────────────────────────────────────────────────────────────────
# Profit Machines – Environment Variables Template (.env.example)
# ─────────────────────────────────────────────────────────────────
# For LOCAL dev: Copy to .env.local and fill in your values.
# For VERCEL:    Add all vars in Vercel Dashboard → Settings → Environment Variables
#                then Redeploy for changes to take effect.
# ─────────────────────────────────────────────────────────────────

# ── 1. GOOGLE APPS SCRIPT WEBHOOK URL (SHEET 1: DATA COLLECTION) ──
# Web App URL generated from Sheet 1 Apps Script deployment (ends in /exec).
# Receives 95-column telemetry, form leads, audits, and chatbot conversations.
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SHEET1_DEPLOYMENT_ID/exec
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SHEET1_DEPLOYMENT_ID/exec

# ── 2. GOOGLE APPS SCRIPT ANALYTICS API URL (SHEET 2: ANALYTICS) ──
# Web App URL generated from Sheet 2 Apps Script deployment (ends in /exec).
GOOGLE_ANALYTICS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SHEET2_DEPLOYMENT_ID/exec
VITE_GOOGLE_ANALYTICS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SHEET2_DEPLOYMENT_ID/exec

# ── 3. SPREADSHEET IDENTIFIERS ──────────────────────────────────
# Sheet 1: Data Collection & 13 Multi-Intelligence Layers
VITE_GOOGLE_SHEET_ID=1E6Yf0dr0QbwSnnWAZUBrndEW5dAUSNgBR5scadxyw3E
GOOGLE_SHEET_ID=1E6Yf0dr0QbwSnnWAZUBrndEW5dAUSNgBR5scadxyw3E

# Sheet 2: 16 Visual Executive Dashboards & Behavioral Analytics Hub
ANALYTICS_SPREADSHEET_ID=1ixHEGyvGHWRDlz2ZBpIY_3-53qmIy7MUfb7X6KLKYmg

# ── 4. ANALYTICS API SECURITY KEY ───────────────────────────────
ANALYTICS_API_KEY=profitmachines_analytics_secure_key_2026

# ── 5. NOTIFICATION RECIPIENT & SENDER ─────────────────────────
TEAM_NOTIFICATION_EMAIL=asmitha.int2027g3@gmail.com
FROM_EMAIL=Profit Machines <noreply@profitmachines.com>

# ── 6. EMAIL SERVICE (RESEND - OPTIONAL) ────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 7. JIRA CLOUD PIPELINE & LEAD CAPTURE (SEPARATE FROM SHEETS) 
JIRA_HOST=trustworkz.atlassian.net
JIRA_EMAIL=asmitha.int2027g3@gmail.com
JIRA_API_TOKEN=your_atlassian_api_token_here
JIRA_PROJECT_KEY=PROF
JIRA_BOARD_URL=https://trustworkz.atlassian.net/jira/software/projects/PROF/boards/101
JIRA_TASK_ISSUE_TYPE=Task
JIRA_SUBTASK_ISSUE_TYPE=Subtask
JIRA_LEAD_NOTIFICATION_EMAIL=asmitha.int2027g3@gmail.com

# ── 8. MICROSOFT CLARITY ─────────────────────────────────────────
# Clarity Project ID — Session recordings, heatmaps & dashboards
# Get your project ID from: https://clarity.microsoft.com
VITE_CLARITY_PROJECT_ID=your_clarity_project_id_here

# ── 9. AIRTABLE CRM PIPELINE ──────────────────────────────────────
# Personal Access Token (PAT), Base ID & Table name for ProfitMachines CRM
# Get your PAT from: https://airtable.com/create/tokens
AIRTABLE_PAT=your_airtable_personal_access_token_here
AIRTABLE_BASE_ID=appFHphPzP7b2VYq1
AIRTABLE_TABLE_NAME=Leads

# ── 10. LINKEDIN COMPANY INTEGRATION & ORGANIC LEAD EXTRACTION ──────
# 1. LINKEDIN_CLIENT_ID: OAuth 2.0 Client ID from LinkedIn Developer Portal
LINKEDIN_CLIENT_ID=your_linkedin_app_client_id_here

# 2. LINKEDIN_CLIENT_SECRET: OAuth 2.0 Client Secret
LINKEDIN_CLIENT_SECRET=your_linkedin_app_client_secret_here

# 3. LINKEDIN_REDIRECT_URI: Authorized OAuth redirect URI
LINKEDIN_REDIRECT_URI=https://profitmachines.ai/api/auth/linkedin/callback

# 4. LINKEDIN_ORG_ID: The numerical Organization ID from your LinkedIn Company Page admin URL:
#    e.g. https://www.linkedin.com/company/105492812/admin/ -> 105492812
LINKEDIN_ORG_ID=your_linkedin_company_organization_id_here

# 5. LINKEDIN_ACCESS_TOKEN: OAuth 2.0 access token with "r_organization_social" & "w_organization_social"
LINKEDIN_ACCESS_TOKEN=your_linkedin_oauth_access_token_here

# 6. LINKEDIN_SPREADSHEET_ID: Dedicated Google Spreadsheet ID named "ProfitMachines LinkedIn Lead Dashboard"
#    Contains 3 tabs: Post Analytics, Organic Engagement, Potential Leads
LINKEDIN_SPREADSHEET_ID=your_linkedin_lead_spreadsheet_id_here

# 7. CRON_SECRET: Secret key for authorizing the scheduled publishing and lead sync worker
CRON_SECRET=profitmachines_secure_cron_2026

# ── 11. YOUTUBE LEAD GENERATION & ANALYTICS PIPELINE ─────────────
# 1. YOUTUBE_API_KEY: Public YouTube Data API v3 key (Google Cloud Console)
YOUTUBE_API_KEY=your_youtube_api_key_here

# 2. YOUTUBE_CLIENT_ID & YOUTUBE_CLIENT_SECRET: OAuth 2.0 Web Application credentials
YOUTUBE_CLIENT_ID=your_youtube_oauth_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_youtube_oauth_client_secret

# 3. YOUTUBE_REFRESH_TOKEN: Authorized refresh token with youtube.readonly and yt-analytics.readonly scopes
YOUTUBE_REFRESH_TOKEN=your_youtube_oauth_refresh_token

# 4. YOUTUBE_CHANNEL_ID: Your ProfitMachines YouTube Channel ID (starts with UC...)
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here

# 5. YOUTUBE_SPREADSHEET_ID: Dedicated Google Spreadsheet ID named "ProfitMachines YouTube Analytics"
# (Separate from Sheet 1 and Sheet 2)
YOUTUBE_SPREADSHEET_ID=your_youtube_analytics_spreadsheet_id_here

# 6. YOUTUBE_AIRTABLE_TABLE: Airtable table name for YouTube engagement/leads (defaults to "Leads" or "YouTube Engagement")
YOUTUBE_AIRTABLE_TABLE=YouTube Engagement

# ── 12. GOOGLE CALENDAR INTEGRATION (CONSULTATION BOOKING) ───────────────
# OAuth 2.0 credentials for Google Calendar API — used by /api/calendar-availability and /api/book-calendar.
# Create in Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web Application).
# Enable the "Google Calendar API" in APIs & Services → Library.
#
# 1. GCAL_CLIENT_ID: OAuth 2.0 Client ID from Google Cloud Console
GCAL_CLIENT_ID=your_google_calendar_client_id.apps.googleusercontent.com

# 2. GCAL_CLIENT_SECRET: OAuth 2.0 Client Secret
GCAL_CLIENT_SECRET=your_google_calendar_client_secret

# 3. GCAL_REFRESH_TOKEN: Refresh token from the owner's Google account authorization.
#    Generate using the OAuth2 Playground (https://developers.google.com/oauthplayground)
#    with scope: https://www.googleapis.com/auth/calendar
GCAL_REFRESH_TOKEN=your_google_calendar_refresh_token

# 4. GCAL_CALENDAR_ID: Calendar ID to check availability and create events in.
#    Use "primary" for the owner's main calendar, or a specific calendar ID.
GCAL_CALENDAR_ID=primary

# 5. GCAL_OWNER_EMAIL: Owner's email to add as organizer on events.
GCAL_OWNER_EMAIL=asmitha.int2027g3@gmail.com

# 6. GCAL_OWNER_TIMEZONE: Owner's primary timezone (IANA format)
GCAL_OWNER_TIMEZONE=Asia/Kolkata


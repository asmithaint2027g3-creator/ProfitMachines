# ─────────────────────────────────────────────────────────────────
# Profit Machines – Environment Variables Template (.env.example)
# ─────────────────────────────────────────────────────────────────
# For LOCAL dev: Copy to .env.local and fill in your values.
# For VERCEL:    Add all vars in Vercel Dashboard → Settings → Environment Variables
#                then Redeploy for changes to take effect.
# ─────────────────────────────────────────────────────────────────

# ── 1. GOOGLE APPS SCRIPT WEBHOOK URL (SHEET 1: DATA COLLECTION) ──
# Web App URL generated from Sheet 1 Apps Script deployment (ends in /exec).
# Receives 95-column telemetry, form leads, audits, and chatbot conversations.
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SHEET1_DEPLOYMENT_ID/exec
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SHEET1_DEPLOYMENT_ID/exec

# ── 2. GOOGLE APPS SCRIPT ANALYTICS API URL (SHEET 2: ANALYTICS) ──
# Web App URL generated from Sheet 2 Apps Script deployment (ends in /exec).
GOOGLE_ANALYTICS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SHEET2_DEPLOYMENT_ID/exec
VITE_GOOGLE_ANALYTICS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SHEET2_DEPLOYMENT_ID/exec

# ── 3. SPREADSHEET IDENTIFIERS ──────────────────────────────────
# Sheet 1: Data Collection & 13 Multi-Intelligence Layers
VITE_GOOGLE_SHEET_ID=1E6Yf0dr0QbwSnnWAZUBrndEW5dAUSNgBR5scadxyw3E
GOOGLE_SHEET_ID=1E6Yf0dr0QbwSnnWAZUBrndEW5dAUSNgBR5scadxyw3E

# Sheet 2: 16 Visual Executive Dashboards & Behavioral Analytics Hub
ANALYTICS_SPREADSHEET_ID=1ixHEGyvGHWRDlz2ZBpIY_3-53qmIy7MUfb7X6KLKYmg

# ── 4. ANALYTICS API SECURITY KEY ───────────────────────────────
ANALYTICS_API_KEY=profitmachines_analytics_secure_key_2026

# ── 5. NOTIFICATION RECIPIENT & SENDER ─────────────────────────
TEAM_NOTIFICATION_EMAIL=asmitha.int2027g3@gmail.com
FROM_EMAIL=Profit Machines <noreply@profitmachines.com>

# ── 6. EMAIL SERVICE (RESEND - OPTIONAL) ────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 7. JIRA CLOUD PIPELINE & LEAD CAPTURE (SEPARATE FROM SHEETS) 
JIRA_HOST=trustworkz.atlassian.net
JIRA_EMAIL=asmitha.int2027g3@gmail.com
JIRA_API_TOKEN=your_atlassian_api_token_here
JIRA_PROJECT_KEY=PROF
JIRA_BOARD_URL=https://trustworkz.atlassian.net/jira/software/projects/PROF/boards/101
JIRA_TASK_ISSUE_TYPE=Task
JIRA_SUBTASK_ISSUE_TYPE=Subtask
JIRA_LEAD_NOTIFICATION_EMAIL=asmitha.int2027g3@gmail.com

# ── 8. MICROSOFT CLARITY ─────────────────────────────────────────
# Clarity Project ID — Session recordings, heatmaps & dashboards
# Get your project ID from: https://clarity.microsoft.com
VITE_CLARITY_PROJECT_ID=your_clarity_project_id_here

# ── 9. AIRTABLE CRM PIPELINE ──────────────────────────────────────
# Personal Access Token (PAT), Base ID & Table name for ProfitMachines CRM
# Get your PAT from: https://airtable.com/create/tokens
AIRTABLE_PAT=your_airtable_personal_access_token_here
AIRTABLE_BASE_ID=appFHphPzP7b2VYq1
AIRTABLE_TABLE_NAME=Leads

# ── 10. LINKEDIN COMPANY PAGE PUBLISHING (STRICT ORGANIZATION-ONLY) ──
# 1. LINKEDIN_ORG_ID: The numerical Organization ID from your LinkedIn Company Page admin URL:
#    e.g. https://www.linkedin.com/company/105492812/admin/ -> 105492812
LINKEDIN_ORG_ID=your_linkedin_company_organization_id_here

# 2. LINKEDIN_ACCESS_TOKEN: OAuth 2.0 access token with "w_organization_social" scope
#    Generated from LinkedIn Developer App for the Super Admin / Content Admin of ProfitMachines
LINKEDIN_ACCESS_TOKEN=your_linkedin_oauth_access_token_here

# 3. CRON_SECRET: Secret key for authorizing the scheduled publishing worker (/api/cron-publish)
CRON_SECRET=profitmachines_secure_cron_2026



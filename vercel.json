{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/youtube-sync",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/process-report?type=daily",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/process-report?type=weekly",
      "schedule": "30 3 * * 1"
    },
    {
      "path": "/api/process-report?type=monthly",
      "schedule": "30 3 1 * *"
    }
  ]
}
